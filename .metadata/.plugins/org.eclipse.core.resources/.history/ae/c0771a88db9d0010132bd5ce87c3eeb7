package oops;

//super/parent/base
class A
{
		int id = 10;
		public void display()
		{
			System.out.println("runing class A display...");
		}
}

//sub/child/derived
class B extends A
{
	int id = 45;
	public void sample()
	{
		int id = 70;
		System.out.println(id);
		System.out.println(this.id);
		System.out.println(super.id);
	}
}


