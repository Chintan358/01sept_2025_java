package thread;

class Th1 implements Runnable
{

	@Override
	public void run() {
		
		for(int i=1;i<=10;i++)
		{
			System.out.println(i);
		}
		
	}
	
}

public class T002_RunnableInterface {
	public static void main(String[] args) {
		
		Th1 t1 = new Th1();
		Th1 t2 = new Th1();
		
		Thread th1  =new Thread(t1);
		Thread th2 = new Thread(t2);
		
		th1.start();
		th2.start();
		
	}
}
