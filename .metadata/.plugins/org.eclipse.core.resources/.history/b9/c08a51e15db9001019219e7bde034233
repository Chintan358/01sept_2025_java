package thread;

class Demo extends Thread
{
	public void run()
	{
		for(int i=1;i<=5;i++)
		{
			System.out.println(Thread.currentThread().getName()+" : "+i);
		}
	}
}
public class T003_JoinDemo {
	public static void main(String[] args) {
		
			Demo d1 = new Demo();
			Demo d2 = new Demo();
			Demo d3  =new Demo();
			
			d1.start();
			d2.start();
			d3.start();
		
	}
}
