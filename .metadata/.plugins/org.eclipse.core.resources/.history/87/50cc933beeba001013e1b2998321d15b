package thread;

class Calc
{
	public void table(int number)
	{
		for(int i=1;i<=10;i++)
		{
			System.out.println(number*i);
		}
	}
}

class Test extends Thread
{
	public void run()
	{
		Calc c = new Calc();
		c.table(5);
	}
}
public class T005_MethodSync {
	public static void main(String[] args) {
		
		Test t1  =new Test();
		t1.run();
		
	}
}
